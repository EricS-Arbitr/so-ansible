# ============================================================
# so-ansible — Ansible inventory
# ============================================================
# Blueprint: blueprints/so_arbitr_dev.yml (ARBITR_SO_DEV)
# Mgmt plane: 10.255.240.0/20 — ansible_host = mgmt IP (per host_vars)
# Ansible controller dual-homed: 10.10.10.10 (control-10) + 10.255.240.157 (mgmt)
# ============================================================

# ------------------------------------------------------------
# Ansible controller itself — needed for local-mirror role.
# Runs `so_apt_mirror` (nginx serving the SO ISO).
# ------------------------------------------------------------
[ansible_controller]
ansible ansible_connection=local

# ------------------------------------------------------------
# Network — router-0 is VyOS; runs vyos_mirror role (GRE + tc mirred).
# ------------------------------------------------------------
[net_vyos]
router-0

# ------------------------------------------------------------
# Security Onion 2.4.x — distributed deploy.
# so_manager MUST deploy before so_search + so_sensor (nodes join manager).
# ------------------------------------------------------------
[so_manager]
so-manager

[so_search]
so-search

[so_sensor]
so-sensor-1

# All SO Linux nodes (for baseline hardening / common role application).
[so_all:children]
so_manager
so_search
so_sensor

# ------------------------------------------------------------
# Windows targets. Renamed from `windows_placeholder` 2026-07-29 when
# playbooks/00-setup.yml was added — that playbook targets `windows`
# directly (init role + adapter rename + common role), so these hosts are
# now provisioned, not merely listed. This widens architecture decision #3
# ("Windows out of scope"): baseline setup is now IN scope; AD promotion,
# user creation and domain join remain OUT.
#
# NIC mapping after 00-setup's rename play: Ethernet0 = mgmt
# (10.255.240.0/20, position FIRST in the blueprint), Ethernet1 = prod.
# ------------------------------------------------------------
[windows]
DC01
ops-wks-01
eng-wks-01

# ------------------------------------------------------------
# Linux hosts that 00-setup.yml's `common` role + NetworkManager
# pre-config apply to. Deliberately NOT everything Linux in this file:
#
#   - `ansible` (the controller) is EXCLUDED. It runs with
#     ansible_connection=local, and common performs a systemd-networkd →
#     NetworkManager cutover plus a netplan overwrite and reboot. Doing
#     that to the box executing the play would sever the run mid-flight.
#   - `router-0` is EXCLUDED. It is VyOS — the play's apt + NetworkManager
#     tasks would fail outright.
#
# That leaves the three SO nodes, which is what the NM pre-config play in
# 00-setup was written for (it names eth0/eth1 and netplan's
# renderer:NetworkManager stub explicitly).
# ------------------------------------------------------------
[linux]
so-manager
so-search
so-sensor-1
